rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Any authenticated Firebase user is considered an admin.
      // This is intentional: the /admin route is already protected by
      // Firebase Auth on the frontend (unauthenticated users are redirected
      // to /admin/login before any Firestore operation is attempted).
      //
      // To harden further (recommended for production):
      //   1. Set a custom claim:  admin.setCustomUserClaims(uid, { admin: true })
      //   2. Change this to:      return request.auth.token.admin == true;
      return request.auth != null;
    }

    match /questions/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /parties/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partyAnswers/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteTexts/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /responses/{doc} {
      allow create: if true;   // usuarios pueden guardar respuestas
      allow read: if isAdmin(); // solo admin ve analytics
      allow update, delete: if false;
    }

    // Bloquear cualquier colección no declarada explícitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}